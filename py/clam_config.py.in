# Generated by CMake at configure time -- do not edit.
#
# Values recorded from CMake so the installed clam.py matches the toolchain it
# was built against (single source of truth: CLAM_LLVM_VERSION).
#
# llvm_version:   the LLVM major release Clam targets.
# llvm_tools_dir: directory of that LLVM's clang/opt/llvm-dis. clam.py puts it
#                 first on PATH so it compiles bitcode with a matching clang
#                 rather than whatever clang happens to be first on PATH (whose
#                 bitcode the LLVM Clam tools may not be able to read).
llvm_version = "@CLAM_LLVM_VERSION@"
llvm_tools_dir = "@LLVM_TOOLS_BINARY_DIR@"
