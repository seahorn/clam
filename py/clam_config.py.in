# Generated by CMake at configure time -- do not edit.
#
# Directory of the LLVM toolchain (clang, opt, llvm-dis, ...) that Clam was
# built against. clam.py puts this first on PATH so it compiles bitcode with a
# matching clang rather than whatever clang happens to be first on PATH (whose
# bitcode the LLVM-@CLAM_LLVM_VERSION@ Clam tools may not be able to read).
llvm_tools_dir = "@LLVM_TOOLS_BINARY_DIR@"
