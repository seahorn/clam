{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CrabIR",
  "scopeName": "source.crabir",
  "fileTypes": ["crabir"],
  "information_for_contributors": [
    "This grammar highlights the CrabIR *analysis report* written by Clam's --ocrab option,",
    "i.e. the file produced by:",
    "    clam.py prog.c --crab-check=assert --ocrab=prog.crabir MORE_OPTIONS",
    "Besides CrabIR instructions, such a file interleaves two kinds of Clam annotation:",
    "  - /** INVARIANTS: ... **/ blocks (optionally with a VARIABLES-OF-INFLUENCE: section),",
    "  - // loc(...) id=N Result:  OK | FAIL -- ... comments above each assert.",
    "Instruction and type names are kept in sync with crab's statement printers in",
    "crab/include/crab/cfg/cfg.hpp and crab/include/crab/types/variable.hpp.",
    "Binary operators are printed by crab as symbols (+ - * / /_u % %_u & | ^ << >>_l >>_r),",
    "not as mnemonics, so there are no arithmetic keywords to match."
  ],
  "patterns": [
    { "include": "#check-result-ok" },
    { "include": "#check-result-fail" },
    { "include": "#annotation-block" },
    { "include": "#block-comment" },
    { "include": "#line-comment" },
    { "include": "#function-declaration" },
    { "include": "#call-site" },
    { "include": "#intrinsic" },
    { "include": "#label" },
    { "include": "#goto" },
    { "include": "#keywords-control" },
    { "include": "#keywords-memory" },
    { "include": "#keywords-array" },
    { "include": "#keywords-cast" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#variables" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "check-result-ok": {
      "comment": "// loc(file=... line=... col=...) id=N Result:  OK",
      "match": "^\\s*(//.*\\bResult:)\\s*(OK\\b.*)$",
      "captures": {
        "1": { "name": "comment.line.double-slash.crabir" },
        "2": { "name": "markup.inserted.check.ok.crabir" }
      }
    },
    "check-result-fail": {
      "comment": "// loc(...) id=N Result:  FAIL -- num of warnings=1",
      "match": "^\\s*(//.*\\bResult:)\\s*(FAIL\\b.*)$",
      "captures": {
        "1": { "name": "comment.line.double-slash.crabir" },
        "2": { "name": "markup.deleted.check.fail.crabir" }
      }
    },
    "annotation-block": {
      "comment": "Clam annotation blocks: /** INVARIANTS: ... **/",
      "name": "comment.block.documentation.crabir",
      "begin": "/\\*\\*",
      "end": "\\*\\*/",
      "patterns": [
        {
          "match": "\\b(INVARIANTS|VARIABLES-OF-INFLUENCE|UNPROVEN ASSUMPTIONS)\\s*:",
          "captures": {
            "1": { "name": "keyword.other.annotation.crabir" }
          }
        },
        {
          "match": "[-+]oo\\b",
          "name": "constant.language.infinity.crabir"
        }
      ]
    },
    "block-comment": {
      "comment": "Statement comments, e.g. /* nd_int(...)*/ and /* loc(...) id=1 */",
      "name": "comment.block.crabir",
      "begin": "/\\*",
      "end": "\\*/"
    },
    "line-comment": {
      "name": "comment.line.double-slash.crabir",
      "match": "//.*$"
    },
    "function-declaration": {
      "comment": "@V_1:int32 declare main()   /   (s.0:int32,...) declare sum(...)",
      "match": "\\b(declare)\\b\\s+([^\\s(]+)",
      "captures": {
        "1": { "name": "keyword.other.declare.crabir" },
        "2": { "name": "entity.name.function.crabir" }
      }
    },
    "call-site": {
      "comment": "(x:int32,...)= call sum(...). Does not match a variable named `call'.",
      "match": "\\b(call)\\b\\s+([^\\s(]+)",
      "captures": {
        "1": { "name": "keyword.control.call.crabir" },
        "2": { "name": "entity.name.function.crabir" }
      }
    },
    "intrinsic": {
      "comment": "crab_intrinsic(unfreed_or_null, ...)",
      "match": "\\b(crab_intrinsic)\\s*\\(\\s*([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.intrinsic.crabir" },
        "2": { "name": "support.function.intrinsic.crabir" }
      }
    },
    "label": {
      "comment": "Basic block labels occupy a whole line, e.g. `entry:', `__@bb_5:'. Anchoring to the line keeps operand type annotations such as `p.addr.0:ref' from matching.",
      "match": "^([^\\s:]+):\\s*$",
      "captures": {
        "1": { "name": "entity.name.label.crabir" }
      }
    },
    "goto": {
      "match": "\\b(goto)\\b\\s+([^;\\n]+)",
      "captures": {
        "1": { "name": "keyword.control.goto.crabir" },
        "2": { "name": "entity.name.label.crabir" }
      }
    },
    "keywords-control": {
      "name": "keyword.control.crabir",
      "match": "\\b(assume|unreachable|assert|havoc|ite|not)\\b"
    },
    "keywords-memory": {
      "comment": "Region and reference statements.",
      "name": "keyword.other.memory.crabir",
      "match": "\\b(region_init|region_copy|region_cast|make_ref|remove_ref|gep_ref|load_from_ref|store_to_ref|ref_to_int|int_to_ref)\\b"
    },
    "keywords-array": {
      "name": "keyword.other.array.crabir",
      "match": "\\b(array_init|array_store|array_load|array_assign)\\b"
    },
    "keywords-cast": {
      "comment": "Integer casts are printed as `trunc x:32 to y:8'; region casts as `region_cast x:t to y:t'.",
      "name": "keyword.operator.cast.crabir",
      "match": "\\b(trunc|sext|zext|to)\\b"
    },
    "types": {
      "patterns": [
        {
          "comment": "The integer bitwidth is arbitrary (int1, int32, int128, ...).",
          "name": "storage.type.integer.crabir",
          "match": "\\bint\\d*\\b"
        },
        {
          "name": "storage.type.crabir",
          "match": "\\b(void|bool|real|ref|arr|region|unknown)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.crabir",
          "match": "\\b(NULL_REF|true|false)\\b"
        },
        {
          "name": "constant.language.infinity.crabir",
          "match": "[-+]oo\\b"
        },
        {
          "comment": "Allocation sites, e.g. as_0.",
          "name": "constant.other.allocation-site.crabir",
          "match": "\\bas_\\d+\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "comment": "Shadow/global variables introduced by Clam, e.g. @V_4.",
          "name": "variable.other.global.crabir",
          "match": "@[A-Za-z0-9_$.-]+"
        },
        {
          "name": "variable.other.constant.crabir",
          "match": "\\.str\\.\\d+\\b"
        }
      ]
    },
    "numbers": {
      "comment": "The lookbehind keeps the `0' of `i.0' and the `5' of `bb_5' from reading as literals.",
      "name": "constant.numeric.crabir",
      "match": "(?<![\\w.$])-?\\d+\\b"
    },
    "operators": {
      "name": "keyword.operator.crabir",
      "match": "(:=|<<|>>_l|>>_r|/_u|%_u|<=|>=|==|!=|[-+*/%&|^<>=])"
    }
  }
}
